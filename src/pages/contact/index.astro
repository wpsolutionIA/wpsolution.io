---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LeadForm from "../../components/LeadForm.astro";
import { SITE } from "../../data/site";
---
<Base title="Contactez WP Solution — Devis Gratuit sous 24h | Agence IA & Web" description="Contactez WP Solution pour un devis gratuit. Agence IA & Web en France. Réponse sous 24h." path="/contact/" locale="fr">
  <Header />
  <main>
    <section class="relative bg-slate-900 text-white py-20 lg:py-24">
      <div class="absolute inset-0 bg-grid opacity-30 pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-5 lg:px-8 relative">
        <span class="chip chip-dark mb-4">Contact</span>
        <h1 class="font-display text-5xl lg:text-6xl tracking-tight mb-4">Contactez-nous</h1>
        <p class="text-xl text-slate-300 max-w-2xl">Un projet en tête ? Une question ? Remplissez le formulaire ou appelez-nous directement. Réponse sous 24h.</p>
      </div>
    </section>

    <section class="section-pad bg-white">
      <div class="max-w-7xl mx-auto px-5 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-12">
          <div class="lg:col-span-5 space-y-8">
            <div>
              <h2 class="font-display text-3xl text-slate-900 mb-6">Nos coordonnées</h2>
              <div class="space-y-5">
                <a href={`mailto:${SITE.email}`} class="flex items-start gap-4 group">
                  <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                  </div>
                  <div>
                    <div class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-1">Email</div>
                    <div class="text-slate-900 group-hover:text-brand-600 transition-colors">{SITE.email}</div>
                  </div>
                </a>
                <a href={SITE.phoneHref} class="flex items-start gap-4 group">
                  <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  </div>
                  <div>
                    <div class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-1">Téléphone</div>
                    <div class="text-slate-900 group-hover:text-brand-600 transition-colors">{SITE.phone}</div>
                  </div>
                </a>
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  </div>
                  <div>
                    <div class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-1">Adresse</div>
                    <div class="text-slate-900">{SITE.address}</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">
              <h3 class="font-semibold text-slate-900 mb-2">Horaires de disponibilité</h3>
              <p class="text-sm text-slate-600">Lundi – Vendredi : 9h – 19h<br/>Week-end : Sur rendez-vous</p>
            </div>
          </div>
          <div class="lg:col-span-7">
            <LeadForm variant="full" />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
