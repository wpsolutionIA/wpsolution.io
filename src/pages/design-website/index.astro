---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LeadForm from "../../components/LeadForm.astro";
---
<Base title="Design de Site Web UI/UX sur Mesure — Figma & Prototype | WP Solution" description="Design UI/UX sur mesure pour sites web professionnels. Maquettes Figma, design responsive, identité visuelle cohérente." path="/design-website/">
  <Header />
  <main>
    <section class="relative bg-slate-950 text-white flex items-center min-h-[70vh]">
      <div class="absolute inset-0">
        <img src="/images/service-web.png" alt="" class="w-full h-full object-cover opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/50"></div>
      </div>
      <div class="max-w-7xl mx-auto px-5 lg:px-8 py-16 relative">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-8">
            <h1 class="font-display text-4xl lg:text-6xl tracking-tight leading-[0.96] mb-5">Un design qui vous ressemble et qui convertit.</h1>
            <p class="text-lg lg:text-xl text-slate-300 leading-relaxed max-w-2xl mb-8">Nous concevons des interfaces sur mesure — Figma, wireframes, prototypes. Chaque écran est pensé pour vos utilisateurs et vos objectifs business.</p>
            <div class="flex flex-wrap gap-3">
              <a href="/contact/" class="btn-coral text-base">Demander un devis →</a>
            </div>
          </div>
          <div class="lg:col-span-4">
            <LeadForm variant="compact" title="Devis design" subtitle="Décrivez votre projet design." />
          </div>
        </div>
      </div>
    </section>
    <section class="section-pad bg-white">
      <div class="max-w-4xl mx-auto px-5 lg:px-8">
        <h2 class="font-display text-3xl text-slate-900 mb-8">Notre process design</h2>
        <div class="space-y-6">
          {[
            { step: "01", title: "Brief & inspiration", desc: "On écoute vos besoins, on étudie votre marché, on collecte vos inspirations." },
            { step: "02", title: "Wireframes & zoning", desc: "Structure des pages, parcours utilisateur, hiérarchie de l'information." },
            { step: "03", title: "Maquettes Figma HD", desc: "Design visuel complet : couleurs, typographie, composants, responsive." },
            { step: "04", title: "Prototype interactif", desc: "Navigation cliquable pour valider l'expérience avant développement." },
          ].map(p => (
            <div class="flex gap-4 items-start">
              <div class="font-display text-3xl text-brand-600 w-12 shrink-0">{p.step}</div>
              <div>
                <h3 class="font-semibold text-slate-900 text-lg mb-1">{p.title}</h3>
                <p class="text-slate-600">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section-pad bg-slate-900 text-white text-center">
      <div class="max-w-2xl mx-auto px-5">
        <h2 class="font-display text-3xl mb-4">Prêt à donner vie à votre projet ?</h2>
        <p class="text-slate-300 mb-6">Un design unique, pas un template. Parlons-en.</p>
        <a href="/contact/" class="btn-coral text-base">Contactez-nous</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
