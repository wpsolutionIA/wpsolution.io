---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LeadForm from "../../components/LeadForm.astro";
---
<Base title="Expert Elementor Pro — Sites WordPress Performants | WP Solution" description="Création de sites WordPress avec Elementor Pro. Design sur mesure, performances optimisées, formation incluse." path="/elementor-1316/">
  <Header />
  <main>
    <section class="relative bg-slate-950 text-white flex items-center min-h-[70vh]">
      <div class="absolute inset-0">
        <img src="/images/service-web.png" alt="" class="w-full h-full object-cover opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/50"></div>
      </div>
      <div class="max-w-7xl mx-auto px-5 lg:px-8 py-16 relative">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-8">
            <h1 class="font-display text-4xl lg:text-6xl tracking-tight leading-[0.96] mb-5">Expert Elementor Pro depuis 2019.</h1>
            <p class="text-lg lg:text-xl text-slate-300 leading-relaxed max-w-2xl mb-8">Nous maîtrisons Elementor Pro sur le bout des doigts : designs complexes, boucles dynamiques, popups, formulaires avancés, intégrations API.</p>
            <div class="flex flex-wrap gap-3">
              <a href="/contact/" class="btn-coral text-base">Demander un devis →</a>
            </div>
          </div>
          <div class="lg:col-span-4">
            <LeadForm variant="compact" title="Projet Elementor" subtitle="Décrivez votre besoin." />
          </div>
        </div>
      </div>
    </section>
    <section class="section-pad bg-white">
      <div class="max-w-4xl mx-auto px-5 lg:px-8">
        <h2 class="font-display text-3xl text-slate-900 mb-8">Pourquoi Elementor Pro avec nous ?</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {[
            "Design 100% personnalisé (pas de template)",
            "Performances Core Web Vitals optimisées",
            "Formation à l'administration incluse",
            "Intégrations CRM, emailing, paiement",
            "Mobile-first responsive",
            "SEO technique intégré",
            "Maintenance évolutive possible",
            "Support post-livraison 30 jours",
          ].map(f => (
            <div class="flex items-start gap-3 card p-4">
              <div class="w-6 h-6 rounded bg-brand-50 text-brand-600 flex items-center justify-center shrink-0 mt-0.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
              <span class="text-sm text-slate-700">{f}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section-pad bg-slate-900 text-white text-center">
      <div class="max-w-2xl mx-auto px-5">
        <h2 class="font-display text-3xl mb-4">Un site Elementor qui dépote</h2>
        <p class="text-slate-300 mb-6">On vous le construit. On vous forme. Vous êtes autonome.</p>
        <a href="/contact/" class="btn-coral text-base">Démarrer</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
