---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LeadForm from "../../components/LeadForm.astro";
---
<Base title="Legal Notice | WP Solution — AI & Web Agency France" description="Legal notice for WP Solution website: publisher, hosting, intellectual property, personal data protection (GDPR)." path="/mentions-legales/" locale="en">
  <Header />
  <main class="max-w-3xl mx-auto px-5 lg:px-8 py-16">
    <h1 class="font-display text-4xl text-slate-900 mb-8">Legal notice</h1>
    <div class="prose prose-slate max-w-none text-sm text-slate-700 leading-relaxed space-y-5">
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Publisher</h2>
        <p>WPSOLUTION LLC<br/>16192 Coastal Highway · Lewes, DE 19958 · USA<br/>Email: contact@wpsolution.io<br/>Phone: +33 7 56 81 94 38</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Publication director</h2>
        <p>Anthony Aiache</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Host</h2>
        <p>Contabo GmbH · Aschauer Straße 32a · 81549 München · Germany</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Intellectual property</h2>
        <p>All content on this site (texts, images, logos, code) is the exclusive property of WP Solution and protected by international copyright laws.</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Liability</h2>
        <p>WP Solution makes its best efforts to ensure accurate information. However, it cannot be held responsible for omissions, inaccuracies, or shortcomings.</p>
      </section>
    </div>
  </main>
  <section class="section-pad bg-slate-50">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <LeadForm variant="inline" title="A legal question?" subtitle="We reply within 24h." service="Legal notice" />
    </div>
  </section>
  <Footer />
</Base>
