---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LeadForm from "../../components/LeadForm.astro";
---
<Base title="Privacy Policy & Data Protection | WP Solution" description="WP Solution privacy policy: data collected, processing purposes, retention period, GDPR rights, cookies policy." path="/politique-confidentialite/" locale="en">
  <Header />
  <main class="max-w-3xl mx-auto px-5 lg:px-8 py-16">
    <h1 class="font-display text-4xl text-slate-900 mb-8">Privacy policy</h1>
    <div class="prose prose-slate max-w-none text-sm text-slate-700 leading-relaxed space-y-5">
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Data controller</h2>
        <p>WP Solution LLC is the data controller for personal data collected through this site.</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Data collected</h2>
        <p>We only collect data you provide voluntarily through our contact forms: name, email, phone, message.</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Purpose</h2>
        <p>Your data is used exclusively to respond to your inquiries. It is never sold or transmitted to third parties.</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Retention</h2>
        <p>Data is retained for 3 years from the last contact, then automatically deleted.</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Your rights (GDPR)</h2>
        <p>You have the right to access, rectify, delete, and oppose the use of your personal data. Send any request to contact@wpsolution.io.</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Cookies</h2>
        <p>This site uses no tracking cookies. Only essential session cookies are used.</p>
      </section>
    </div>
  </main>
  <section class="section-pad bg-slate-50">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <LeadForm variant="inline" title="A question about your data?" subtitle="We reply within 24h." service="Privacy" />
    </div>
  </section>
  <Footer />
</Base>
