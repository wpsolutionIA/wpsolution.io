---
import Base from "../../../layouts/Base.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import LeadForm from "../../../components/LeadForm.astro";
import { SITE } from "../../../data/site";
---
<Base title="Contacto WP Solution — Presupuesto Gratis en 24h | Agencia IA & Web" description="Contacta a WP Solution para un presupuesto gratuito. Agencia IA & Web con sede en Francia. Respuesta en 24h." path="/contact/" locale="es">
  <Header />
  <main>
    <section class="relative bg-slate-900 text-white py-20 lg:py-24">
      <div class="absolute inset-0 bg-grid opacity-30 pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-5 lg:px-8 relative">
        <span class="chip chip-dark mb-4">Contacto</span>
        <h1 class="font-display text-5xl lg:text-6xl tracking-tight mb-4">Contáctenos</h1>
        <p class="text-xl text-slate-300 max-w-2xl">¿Tiene un proyecto en mente? ¿Una pregunta? Complete el formulario o llámenos directamente. Respondemos en 24h.</p>
      </div>
    </section>

    <section class="section-pad bg-white">
      <div class="max-w-7xl mx-auto px-5 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-12">
          <div class="lg:col-span-5 space-y-8">
            <div>
              <h2 class="font-display text-3xl text-slate-900 mb-6">Nuestros datos</h2>
              <div class="space-y-5">
                <a href={`mailto:${SITE.email}`} class="flex items-start gap-4 group">
                  <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                  </div>
                  <div>
                    <div class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-1">Email</div>
                    <div class="text-slate-900 group-hover:text-brand-600 transition-colors">{SITE.email}</div>
                  </div>
                </a>
                <a href={SITE.phoneHref} class="flex items-start gap-4 group">
                  <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  </div>
                  <div>
                    <div class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-1">Teléfono</div>
                    <div class="text-slate-900 group-hover:text-brand-600 transition-colors">{SITE.phone}</div>
                  </div>
                </a>
                <a href={SITE.whatsappUrl} target="_blank" rel="noopener" class="flex items-start gap-4 group">
                  <div class="w-12 h-12 rounded-xl bg-[#25D366]/10 text-[#25D366] flex items-center justify-center flex-shrink-0">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  </div>
                  <div>
                    <div class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-1">WhatsApp</div>
                    <div class="text-slate-900 group-hover:text-[#25D366] transition-colors">Chatear con nosotros</div>
                  </div>
                </a>
              </div>
            </div>
            <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">
              <h3 class="font-semibold text-slate-900 mb-2">Horario de disponibilidad</h3>
              <p class="text-sm text-slate-600">Lunes – Viernes: 9h – 19h (CET)<br/>Fin de semana: Con cita previa</p>
            </div>
          </div>
          <div class="lg:col-span-7">
            <LeadForm variant="full" title="Solicitar presupuesto" subtitle="Complete el formulario. Respondemos en 24h." cta="Enviar solicitud" />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
