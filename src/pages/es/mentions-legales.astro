---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LeadForm from "../../components/LeadForm.astro";
---
<Base title="Aviso Legal | WP Solution — Agencia IA & Web Francia" description="Aviso legal del sitio WP Solution: editor, alojamiento, propiedad intelectual, protección de datos personales (RGPD)." path="/mentions-legales/" locale="es">
  <Header />
  <main class="max-w-3xl mx-auto px-5 lg:px-8 py-16">
    <h1 class="font-display text-4xl text-slate-900 mb-8">Aviso legal</h1>
    <div class="prose prose-slate max-w-none text-sm text-slate-700 leading-relaxed space-y-5">
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Editor</h2>
        <p>WPSOLUTION LLC<br/>16192 Coastal Highway · Lewes, DE 19958 · USA<br/>Email: contact@wpsolution.io<br/>Teléfono: +33 7 56 81 94 38</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Director de publicación</h2>
        <p>Anthony Aiache</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Hosting</h2>
        <p>Contabo GmbH · Aschauer Straße 32a · 81549 München · Alemania</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Propiedad intelectual</h2>
        <p>Todos los contenidos de este sitio (textos, imágenes, logos, código) son propiedad exclusiva de WP Solution y están protegidos por las leyes internacionales sobre derechos de autor.</p>
      </section>
      <section>
        <h2 class="font-semibold text-slate-900 text-lg mt-6 mb-2">Responsabilidad</h2>
        <p>WP Solution hace su mayor esfuerzo para garantizar la exactitud de la información publicada. Sin embargo, no puede ser responsabilizada por omisiones, inexactitudes o carencias.</p>
      </section>
    </div>
  </main>
  <section class="section-pad bg-slate-50">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <LeadForm variant="inline" title="¿Una pregunta legal?" subtitle="Respondemos en 24h." service="Aviso legal" />
    </div>
  </section>
  <Footer />
</Base>
