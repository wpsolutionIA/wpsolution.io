---
import { SITE } from "../data/site";
import LeadForm from "./LeadForm.astro";
---
<section id="contact" class="section-pad relative bg-gradient-to-b from-white to-brand-50/40 overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-5 lg:px-10 relative">
    <div class="grid lg:grid-cols-12 gap-12">

      <!-- Left: copy + contact channels -->
      <div class="lg:col-span-5">
        <p class="chip mb-5">Démarrer un projet</p>
        <h2 class="font-display text-5xl lg:text-6xl tracking-tight leading-[1.05] text-slate-900">
          Parlons-en<br/>
          <span class="italic text-brand-600">honnêtement</span>.
        </h2>
        <p class="text-xl text-slate-600 mt-7 max-w-md leading-relaxed">
          On vous dit en 30 minutes si on est les bons interlocuteurs. Si non, on vous oriente. Si oui, on chiffre clairement.
        </p>

        <!-- Trust badges -->
        <div class="grid grid-cols-3 gap-3 mt-10 mb-10">
          <div class="text-center p-4 rounded-xl bg-white border border-slate-200">
            <div class="font-display text-3xl text-brand-600">24h</div>
            <div class="text-xs text-slate-600 mt-1">Réponse garantie</div>
          </div>
          <div class="text-center p-4 rounded-xl bg-white border border-slate-200">
            <div class="font-display text-3xl text-coral-500">Gratuit</div>
            <div class="text-xs text-slate-600 mt-1">Premier appel</div>
          </div>
          <div class="text-center p-4 rounded-xl bg-white border border-slate-200">
            <div class="font-display text-3xl text-emerald-600">0€</div>
            <div class="text-xs text-slate-600 mt-1">Engagement</div>
          </div>
        </div>

        <div class="space-y-5">
          <a href={`mailto:${SITE.email}`} class="flex items-start gap-4 group">
            <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-brand-600 group-hover:border-brand-600 transition-colors flex-shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div>
              <div class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-1">Email</div>
              <div class="text-slate-900 group-hover:text-brand-600 transition-colors">{SITE.email}</div>
            </div>
          </a>

          <a href={SITE.phoneHref} class="flex items-start gap-4 group">
            <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-brand-600 group-hover:border-brand-600 transition-colors flex-shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div>
              <div class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-1">Téléphone</div>
              <div class="text-slate-900 group-hover:text-brand-600 transition-colors">{SITE.phone}</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Right: full lead form -->
      <div class="lg:col-span-7" id="full-contact-form">
        <LeadForm
          variant="full"
          source="contact-bottom"
          cta="Envoyer ma demande"
        />
      </div>
    </div>
  </div>
</section>
