---
import { SERVICES, CATEGORIES } from "../data/services";
import LeadForm from "./LeadForm.astro";

const byCategory = {
  ai: SERVICES.filter((s) => s.category === "ai"),
  web: SERVICES.filter((s) => s.category === "web"),
  ops: SERVICES.filter((s) => s.category === "ops"),
};

const categoryColors = {
  ai:  { chip: 'bg-brand-50 text-brand-700 border-brand-100',  num: 'text-brand-600',  icon: 'bg-brand-100 text-brand-700' },
  web: { chip: 'bg-coral-50 text-coral-600 border-coral-100',  num: 'text-coral-600',  icon: 'bg-coral-50 text-coral-600' },
  ops: { chip: 'bg-emerald-50 text-emerald-700 border-emerald-100', num: 'text-emerald-600', icon: 'bg-emerald-50 text-emerald-600' },
};
---
<section id="services" class="section-pad relative bg-section-tint">
  <div class="max-w-7xl mx-auto px-5 lg:px-10 relative">

    <div class="mb-16 max-w-3xl">
      <p class="chip mb-5">Nos services</p>
      <h2 class="font-display text-5xl lg:text-6xl tracking-tight leading-[1.05] text-slate-900">
        Trois familles. <br/>
        <span class="italic text-brand-600">Une exigence commune.</span>
      </h2>
      <p class="text-slate-600 text-lg lg:text-xl mt-7 leading-relaxed">
        L'<strong class="text-slate-900">IA est devenue notre métier principal</strong>. Le web reste notre socle. La sécurité et la maintenance — notre signature historique.
      </p>
    </div>

    {(["ai", "web", "ops"] as const).map((cat, idx) => (
      <div class="mb-20">
        <div class="flex items-baseline gap-5 mb-8 flex-wrap pb-4 border-b border-slate-200">
          <span class={`font-mono text-xs ${categoryColors[cat].num} uppercase tracking-[0.3em] font-bold`}>0{idx + 1} / 03</span>
          <h3 class="font-display text-4xl lg:text-5xl text-slate-900">{CATEGORIES[cat].label}</h3>
          <p class="text-slate-500 italic">{CATEGORIES[cat].tagline}</p>
        </div>

        <div class={`grid gap-5 ${byCategory[cat].length === 1 ? "md:grid-cols-1" : byCategory[cat].length === 2 ? "md:grid-cols-2" : "md:grid-cols-2 lg:grid-cols-3"}`}>
          {byCategory[cat].map((svc) => (
            <article class={`card p-7 lg:p-8 group relative ${svc.badge ? "ring-2 ring-brand-500/30" : ""}`}>
              {svc.badge && (
                <span class="absolute top-4 right-4 chip chip-coral !text-[10px]">{svc.badge}</span>
              )}
              <div class="flex items-start gap-4 mb-5">
                <span class={`w-12 h-12 rounded-xl flex items-center justify-center text-2xl ${categoryColors[cat].icon}`}>
                  {svc.icon}
                </span>
              </div>
              <h4 class="font-display text-2xl mb-2.5 leading-tight text-slate-900">{svc.title}</h4>
              <p class="text-brand-700 italic font-medium mb-4 text-sm">{svc.punchline}</p>
              <p class="text-slate-600 mb-5 leading-relaxed text-sm">{svc.description}</p>
              <ul class="space-y-2 mb-6 text-sm text-slate-700">
                {svc.bullets.map((b) => (
                  <li class="flex gap-2.5">
                    <span class={`mt-1 flex-shrink-0 w-1.5 h-1.5 rounded-full ${categoryColors[cat].num.replace('text-','bg-')}`}></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                <span class="font-mono text-xs text-slate-500 uppercase tracking-wider">{svc.pricingFrom}</span>
                <a href="#lead-form" class={`text-sm ${categoryColors[cat].num} hover:underline font-semibold inline-flex items-center gap-1`}>
                  Devis
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        {/* Inline CTA after AI section to capture intent early */}
        {idx === 0 && (
          <div class="mt-12">
            <LeadForm
              variant="inline-cta"
              source="after-ai-services"
              title="Envie de tester un agent IA sur votre activité ?"
              subtitle="On peut vous monter un prototype fonctionnel en 2 semaines. Discutons-en."
              cta="Réserver mon créneau"
            />
          </div>
        )}
      </div>
    ))}
  </div>
</section>
