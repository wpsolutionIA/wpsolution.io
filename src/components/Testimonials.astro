---
import { TESTIMONIALS } from "../data/content";
---
<section class="section-pad relative">
  <div class="max-w-7xl mx-auto px-5 lg:px-10">
    <div class="mb-14 max-w-3xl">
      <p class="chip mb-5">Témoignages</p>
      <h2 class="font-display text-5xl lg:text-6xl tracking-tight leading-[1.05] text-slate-900">
        Ce que nos clients<br/>
        en <span class="italic text-brand-600">disent</span>.
      </h2>
      <div class="flex items-center gap-3 mt-7">
        <div class="flex gap-1 text-amber-400 text-xl">★★★★★</div>
        <span class="font-bold text-slate-900 text-lg">5,0</span>
        <span class="text-slate-600">— Google · 47 avis</span>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {TESTIMONIALS.map((t, i) => (
        <figure class={`card p-7 lg:p-8 ${i === 1 ? "md:translate-y-6 ring-2 ring-brand-500/20" : ""}`}>
          <div class="flex gap-1 mb-5 text-amber-400 text-lg">★★★★★</div>
          <blockquote class="font-display text-xl lg:text-2xl leading-snug text-slate-900 mb-7 italic">
            "{t.quote}"
          </blockquote>
          <figcaption class="flex items-center gap-3 pt-5 border-t border-slate-200">
            <div class="w-11 h-11 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
              {t.name.split(' ').map(n => n[0]).join('').slice(0,2)}
            </div>
            <div>
              <div class="text-slate-900 font-semibold">{t.name}</div>
              <div class="text-slate-500 text-sm">{t.role}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
