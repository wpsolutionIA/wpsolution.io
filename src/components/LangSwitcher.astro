---
import { LOCALES, LOCALE_LABELS, LOCALE_FLAGS, localizedUrl, stripLocale, getLocaleFromPath, type Locale } from "../i18n/translations";

export interface Props {
  variant?: 'desktop' | 'mobile';
}
const { variant = 'desktop' } = Astro.props;

const currentLocale: Locale = getLocaleFromPath(Astro.url.pathname);
const cleanPath = stripLocale(Astro.url.pathname);
---
{variant === 'desktop' ? (
  <div class="relative group" data-lang-switcher>
    <button
      type="button"
      class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-slate-600 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition-colors"
      aria-label="Changer de langue"
      aria-haspopup="true"
    >
      <span class="text-base leading-none">{LOCALE_FLAGS[currentLocale]}</span>
      <span class="font-mono uppercase text-xs tracking-wider">{currentLocale}</span>
      <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>
    <div class="absolute right-0 top-full pt-2 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 z-50">
      <div class="bg-white rounded-xl border border-slate-200 shadow-xl overflow-hidden min-w-[180px]">
        {LOCALES.map(loc => (
          <a
            href={localizedUrl(loc, cleanPath)}
            class:list={[
              "flex items-center gap-3 px-4 py-2.5 text-sm transition-colors",
              loc === currentLocale ? "bg-brand-50 text-brand-700 font-semibold" : "text-slate-700 hover:bg-slate-50 hover:text-brand-600",
            ]}
            hreflang={loc === 'fr' ? 'fr-FR' : loc === 'en' ? 'en-US' : 'es-ES'}
          >
            <span class="text-lg leading-none">{LOCALE_FLAGS[loc]}</span>
            <span class="flex-1">{LOCALE_LABELS[loc]}</span>
            {loc === currentLocale && (
              <svg class="w-4 h-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
) : (
  <div class="flex items-center gap-2 px-4 py-3">
    <span class="text-xs uppercase tracking-widest text-slate-500 font-semibold mr-1">Langue</span>
    {LOCALES.map(loc => (
      <a
        href={localizedUrl(loc, cleanPath)}
        class:list={[
          "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-colors",
          loc === currentLocale ? "bg-brand-100 text-brand-700 font-bold" : "text-slate-600 hover:bg-slate-100",
        ]}
        hreflang={loc === 'fr' ? 'fr-FR' : loc === 'en' ? 'en-US' : 'es-ES'}
      >
        <span class="text-base leading-none">{LOCALE_FLAGS[loc]}</span>
        <span class="font-mono uppercase text-xs">{loc}</span>
      </a>
    ))}
  </div>
)}
