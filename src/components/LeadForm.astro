---
// Smart LeadForm — phone visible on ALL variants, expandable details
export interface Props {
  variant?: 'compact' | 'full' | 'inline' | 'sidebar';
  title?: string;
  subtitle?: string;
  cta?: string;
  service?: string;
}
const { variant = 'full', title, subtitle, cta, service: defaultService } = Astro.props;
const uid = 'lf-' + Math.random().toString(36).slice(2, 8);
const phonePattern = '[0-9 +]{8,}';
---

{variant === 'compact' && (
  <form id={uid} class="lead-form bg-white rounded-2xl shadow-2xl shadow-brand-900/30 border border-slate-200 p-6 max-w-sm" data-lead-form>
    <div class="flex items-center gap-2 mb-4">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping-slow absolute inline-flex h-full w-full rounded-full bg-coral-500 opacity-60"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-coral-500"></span>
      </span>
      <span class="font-mono text-[10px] uppercase tracking-widest text-slate-500">Devis sous 24h</span>
    </div>
    {title && <h3 class="font-display text-2xl text-slate-900 mb-1">{title}</h3>}
    {subtitle && <p class="text-sm text-slate-600 mb-4">{subtitle}</p>}
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="service" value={defaultService || 'Non spécifié'} />
    <div class="space-y-3">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Nom *</span>
        <input required type="text" name="name" placeholder="Jean Dupont" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Email *</span>
        <input required type="email" name="email" placeholder="jean@entreprise.fr" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Téléphone *</span>
        <input required type="tel" name="phone" pattern={phonePattern} placeholder="06 12 34 56 78" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
    </div>
    {/* Expandable details */}
    <div class="mt-3 expandable-details hidden">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Votre projet (optionnel)</span>
        <textarea name="message" rows="2" placeholder="Décrivez votre besoin en quelques mots..." class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition resize-none"></textarea>
      </label>
    </div>
    <button type="button" class="expand-toggle w-full text-xs text-slate-500 hover:text-brand-600 mt-2 pb-1 flex items-center justify-center gap-1 transition-colors">
      <svg class="w-3.5 h-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
      <span>Ajouter un message</span>
    </button>
    <button type="submit" class="btn-coral w-full mt-3 text-base lead-submit">{cta || 'Obtenir mon devis'}</button>
    <p class="lead-msg hidden text-sm font-medium mt-3 text-center"></p>
    <p class="text-[11px] text-slate-500 mt-3 text-center">🔒 Aucun spam · Réponse sous 24h</p>
  </form>
)}

{variant === 'inline' && (
  <form id={uid} class="lead-form bg-gradient-to-br from-brand-600 to-brand-800 rounded-2xl p-8 text-white" data-lead-form>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="service" value={defaultService || 'Demande rapide'} />
    <div class="grid md:grid-cols-5 gap-6 items-end">
      <div class="md:col-span-2">
        {title && <h3 class="font-display text-2xl mb-1">{title}</h3>}
        {subtitle && <p class="text-brand-100 text-sm">{subtitle}</p>}
      </div>
      <label class="block">
        <span class="block text-[10px] font-semibold text-brand-200 uppercase tracking-wider mb-1">Email *</span>
        <input required type="email" name="email" placeholder="jean@entreprise.fr" class="w-full bg-white/10 border-2 border-white/20 rounded-xl px-4 py-3 text-sm text-white placeholder:text-white/50 focus:border-white focus:outline-none transition" />
      </label>
      <label class="block">
        <span class="block text-[10px] font-semibold text-brand-200 uppercase tracking-wider mb-1">Téléphone *</span>
        <input required type="tel" name="phone" pattern={phonePattern} placeholder="06 12 34 56 78" class="w-full bg-white/10 border-2 border-white/20 rounded-xl px-4 py-3 text-sm text-white placeholder:text-white/50 focus:border-white focus:outline-none transition" />
      </label>
      <button type="submit" class="btn-white text-sm lead-submit">{cta || 'Être rappelé'}</button>
    </div>
    <p class="lead-msg hidden text-xs font-medium mt-3 text-center"></p>
  </form>
)}

{variant === 'sidebar' && (
  <form id={uid} class="lead-form card p-6 sticky top-24" data-lead-form>
    {title && <h3 class="font-display text-xl text-slate-900 mb-1">{title}</h3>}
    {subtitle && <p class="text-sm text-slate-600 mb-4">{subtitle}</p>}
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="service" value={defaultService || 'Demande générale'} />
    <div class="space-y-3 mb-3">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Nom *</span>
        <input required type="text" name="name" placeholder="Votre nom" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Email *</span>
        <input required type="email" name="email" placeholder="email@exemple.com" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Téléphone *</span>
        <input required type="tel" name="phone" pattern={phonePattern} placeholder="06 12 34 56 78" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none transition" />
      </label>
    </div>
    <div class="expandable-details hidden space-y-3 mb-3">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Votre projet</span>
        <textarea name="message" rows="3" placeholder="Décrivez votre besoin..." class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none transition resize-none"></textarea>
      </label>
    </div>
    <button type="button" class="expand-toggle w-full text-xs text-slate-500 hover:text-brand-600 mb-2 pb-1 flex items-center justify-center gap-1 transition-colors">
      <svg class="w-3.5 h-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
      <span>Ajouter un message</span>
    </button>
    <button type="submit" class="btn-primary w-full text-sm lead-submit">{cta || 'Envoyer ma demande'}</button>
    <p class="lead-msg hidden text-sm font-medium mt-3 text-center"></p>
  </form>
)}

{variant === 'full' && (
  <form id={uid} class="lead-form card p-8" data-lead-form>
    {title && <h3 class="font-display text-2xl text-slate-900 mb-2">{title}</h3>}
    {subtitle && <p class="text-slate-600 mb-6">{subtitle}</p>}
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="service" value={defaultService || 'Demande générale'} />
    <div class="grid sm:grid-cols-3 gap-4 mb-4">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Nom & Prénom *</span>
        <input required type="text" name="name" placeholder="Jean Dupont" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Email *</span>
        <input required type="email" name="email" placeholder="jean@entreprise.fr" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Téléphone *</span>
        <input required type="tel" name="phone" pattern={phonePattern} placeholder="06 12 34 56 78" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
    </div>
    {/* Expandable: company + message */}
    <button type="button" class="expand-toggle w-full text-left text-xs font-semibold text-slate-500 hover:text-brand-600 pb-2 mb-1 flex items-center gap-2 transition-colors">
      <svg class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>Plus de détails</span>
    </button>
    <div class="expandable-details hidden space-y-4 mb-4">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Société</span>
        <input type="text" name="company" placeholder="Votre entreprise" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Décrivez votre projet</span>
        <textarea name="message" rows="4" placeholder="Objectif, budget, deadline, outils actuels... Soyez précis pour un devis plus rapide." class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition resize-none"></textarea>
      </label>
    </div>
    <button type="submit" class="btn-coral w-full justify-center text-lg lead-submit">{cta || 'Envoyer ma demande'}</button>
    <p class="lead-msg hidden text-sm font-medium mt-4 text-center"></p>
    <div class="flex items-center justify-center gap-6 mt-4 text-xs text-slate-500 flex-wrap">
      <span class="flex items-center gap-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>Réponse sous 24h</span>
      <span class="flex items-center gap-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>Premier appel offert</span>
      <span class="flex items-center gap-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>Sans engagement</span>
    </div>
  </form>
)}

<!-- Expandable details script -->
<script is:inline>
(function() {
  function initToggles() {
    document.querySelectorAll('.expand-toggle').forEach(function(btn) {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', function() {
        var form = btn.closest('form');
        var details = form.querySelector('.expandable-details');
        var icon = btn.querySelector('svg');
        var span = btn.querySelector('span');
        var isHidden = details.classList.contains('hidden');
        if (isHidden) {
          details.classList.remove('hidden');
          icon.style.transform = 'rotate(180deg)';
          if (span && span.textContent.includes('Ajouter')) span.textContent = span.textContent.replace('Ajouter', 'Masquer');
          if (span && span.textContent.includes('Plus')) span.textContent = 'Moins de détails';
        } else {
          details.classList.add('hidden');
          icon.style.transform = '';
          if (span && span.textContent.includes('Masquer')) span.textContent = span.textContent.replace('Masquer', 'Ajouter');
          if (span && span.textContent.includes('Moins')) span.textContent = 'Plus de détails';
        }
      });
    });
  }

  function attachLead(form) {
    if (form.dataset.bound) return;
    form.dataset.bound = '1';
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      var btn = form.querySelector('.lead-submit');
      var msg = form.querySelector('.lead-msg');
      var orig = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Envoi...';
      if (msg) { msg.className = msg.className.replace(/text-(emerald|red)-\d+/g, '') + ' text-slate-500'; msg.classList.remove('hidden'); msg.textContent = 'Envoi de votre demande…'; }
      var data = new FormData(form);
      var payload = {};
      data.forEach(function(v, k) { payload[k] = v; });
      payload.page = window.location.pathname;
      payload.locale = (document.documentElement.lang || 'fr').slice(0, 2);
      if (!payload.name) payload.name = '(non précisé)';
      if (!payload.service) payload.service = 'Demande générale';
      try {
        var r = await fetch('/api/lead.php', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        var json = await r.json().catch(function() { return { ok: false, error: 'Réponse invalide' }; });
        if (r.ok && json.ok) {
          btn.textContent = '✓ Envoyé';
          btn.className = btn.className.replace('btn-coral', 'btn-success').replace('btn-primary', 'btn-success') + ' bg-emerald-600 hover:bg-emerald-700 text-white';
          if (msg) { msg.textContent = 'Merci, on revient vers vous sous 24h.'; msg.className = msg.className.replace('text-slate-500', '') + ' text-emerald-600'; }
          form.querySelectorAll('input:not([type="hidden"]), textarea').forEach(function(el) { if (el.type !== 'submit') el.value = ''; });
        } else { throw new Error(json.error || 'Erreur réseau'); }
      } catch (err) {
        btn.disabled = false; btn.textContent = orig;
        if (msg) { msg.textContent = 'Erreur : ' + err.message + '. Réessayez ou contact@wpsolution.io.'; msg.className = msg.className.replace('text-slate-500', '') + ' text-red-600'; }
      }
    });
  }
  function init() { initToggles(); document.querySelectorAll('[data-lead-form]').forEach(attachLead); }
  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
})();
</script>
