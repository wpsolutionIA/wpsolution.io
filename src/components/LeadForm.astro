---
export interface Props {
  variant?: 'compact' | 'full' | 'inline' | 'sidebar';
  title?: string;
  subtitle?: string;
  cta?: string;
  service?: string;
}
const { variant = 'full', title, subtitle, cta = 'Envoyer ma demande', service: defaultService } = Astro.props;
const formId = 'lf-' + Math.random().toString(36).slice(2, 8);
---

{variant === 'compact' && (
  <form id={formId} class="lead-form bg-white rounded-2xl shadow-2xl shadow-brand-900/30 border border-slate-200 p-6 max-w-sm" data-lead-form>
    <div class="flex items-center gap-2 mb-4">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping-slow absolute inline-flex h-full w-full rounded-full bg-coral-500 opacity-60"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-coral-500"></span>
      </span>
      <span class="font-mono text-[10px] uppercase tracking-widest text-slate-500">Devis sous 24h</span>
    </div>
    {title && <h3 class="font-display text-2xl text-slate-900 mb-1">{title}</h3>}
    {subtitle && <p class="text-sm text-slate-600 mb-4">{subtitle}</p>}
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <div class="space-y-3">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Nom & prénom *</span>
        <input required type="text" name="name" placeholder="Jean Dupont" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Email professionnel *</span>
        <input required type="email" name="email" placeholder="jean@entreprise.fr" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Service souhaité *</span>
        <select required name="service" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition">
          <option value="">— Sélectionner —</option>
          <option selected={defaultService === 'Solutions IA'}>Solutions IA</option>
          <option selected={defaultService === 'Création site WordPress'}>Création site WordPress</option>
          <option selected={defaultService === 'Sécurité WordPress'}>Sécurité WordPress</option>
          <option selected={defaultService === 'Maintenance WordPress'}>Maintenance WordPress</option>
          <option selected={defaultService === 'Référencement SEO'}>Référencement SEO</option>
          <option selected={defaultService === 'E-commerce WooCommerce'}>E-commerce WooCommerce</option>
          <option selected={defaultService === 'Développement sur mesure'}>Développement sur mesure</option>
          <option>Autre</option>
        </select>
      </label>
    </div>
    <button type="submit" class="btn-coral w-full mt-5 text-base lead-submit">{cta}</button>
    <p class="lead-msg hidden text-sm font-medium mt-3 text-center"></p>
    <p class="text-[11px] text-slate-500 mt-3 text-center">🔒 Aucun spam · Réponse sous 24h</p>
  </form>
)}

{variant === 'inline' && (
  <form id={formId} class="lead-form bg-gradient-to-br from-brand-600 to-brand-800 rounded-2xl p-8 text-white" data-lead-form>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="service" value={defaultService || 'Autre'} />
    <input type="hidden" name="name" value="(via inline form)" />
    <div class="grid md:grid-cols-5 gap-6 items-center">
      <div class="md:col-span-3">
        {title && <h3 class="font-display text-2xl mb-2">{title}</h3>}
        {subtitle && <p class="text-brand-100 text-sm">{subtitle}</p>}
      </div>
      <div class="md:col-span-2 space-y-3">
        <input required type="email" name="email" placeholder="Votre email" class="w-full bg-white border-2 border-white/30 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-500 focus:border-white focus:outline-none transition" />
        <button type="submit" class="btn-white w-full text-sm lead-submit">{cta}</button>
        <p class="lead-msg hidden text-xs font-medium text-center"></p>
      </div>
    </div>
  </form>
)}

{variant === 'sidebar' && (
  <form id={formId} class="lead-form card p-6 sticky top-24" data-lead-form>
    {title && <h3 class="font-display text-xl text-slate-900 mb-1">{title}</h3>}
    {subtitle && <p class="text-sm text-slate-600 mb-4">{subtitle}</p>}
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="service" value={defaultService || 'Demande générale'} />
    <div class="space-y-3 mb-4">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Nom *</span>
        <input required type="text" name="name" placeholder="Votre nom" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Email *</span>
        <input required type="email" name="email" placeholder="email@exemple.com" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Votre projet</span>
        <textarea name="message" rows="3" placeholder="Décrivez votre besoin..." class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none transition resize-none"></textarea>
      </label>
    </div>
    <button type="submit" class="btn-primary w-full text-sm lead-submit">{cta}</button>
    <p class="lead-msg hidden text-sm font-medium mt-3 text-center"></p>
  </form>
)}

{variant === 'full' && (
  <form id={formId} class="lead-form card p-8" data-lead-form>
    {title && <h3 class="font-display text-2xl text-slate-900 mb-2">{title}</h3>}
    {subtitle && <p class="text-slate-600 mb-6">{subtitle}</p>}
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <div class="grid sm:grid-cols-2 gap-4 mb-4">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Nom & Prénom *</span>
        <input required type="text" name="name" placeholder="Jean Dupont" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Société</span>
        <input type="text" name="company" placeholder="Acme Inc." class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
    </div>
    <div class="grid sm:grid-cols-2 gap-4 mb-4">
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Email *</span>
        <input required type="email" name="email" placeholder="jean@entreprise.fr" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
      <label class="block">
        <span class="block text-xs font-semibold text-slate-700 mb-1.5">Téléphone</span>
        <input type="tel" name="phone" placeholder="+33 6 12 34 56 78" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition" />
      </label>
    </div>
    <label class="block mb-4">
      <span class="block text-xs font-semibold text-slate-700 mb-1.5">Service souhaité *</span>
      <select required name="service" class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition">
        <option value="">— Sélectionner —</option>
        <option selected={defaultService === 'Solutions IA'}>Solutions IA</option>
        <option selected={defaultService === 'Création site WordPress'}>Création site WordPress</option>
        <option selected={defaultService === 'Sécurité WordPress'}>Sécurité WordPress</option>
        <option selected={defaultService === 'Maintenance WordPress'}>Maintenance WordPress</option>
        <option selected={defaultService === 'Référencement SEO'}>Référencement SEO</option>
        <option selected={defaultService === 'E-commerce WooCommerce'}>E-commerce WooCommerce</option>
        <option selected={defaultService === 'Développement sur mesure'}>Développement sur mesure</option>
        <option>Autre</option>
      </select>
    </label>
    <label class="block mb-6">
      <span class="block text-xs font-semibold text-slate-700 mb-1.5">Décrivez votre projet</span>
      <textarea name="message" rows="4" placeholder="Quelques lignes sur votre projet, vos outils actuels, votre objectif..." class="w-full bg-white border-2 border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-100 transition resize-none"></textarea>
    </label>
    <button type="submit" class="btn-coral w-full justify-center text-lg lead-submit">{cta}</button>
    <p class="lead-msg hidden text-sm font-medium mt-4 text-center"></p>
    <div class="flex items-center justify-center gap-6 mt-4 text-xs text-slate-500 flex-wrap">
      <span class="flex items-center gap-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>Réponse sous 24h</span>
      <span class="flex items-center gap-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>Premier appel offert</span>
      <span class="flex items-center gap-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>Sans engagement</span>
    </div>
  </form>
)}

<script is:inline>
  (function() {
    function attachLead(form) {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = form.querySelector('.lead-submit');
        const msg = form.querySelector('.lead-msg');
        const orig = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Envoi en cours...';
        if (msg) { msg.className = msg.className.replace(/text-(emerald|red)-\d+/g, '') + ' text-slate-500'; msg.classList.remove('hidden'); msg.textContent = 'Envoi de votre demande…'; }

        const data = new FormData(form);
        const payload = {};
        data.forEach(function(v, k) { payload[k] = v; });
        payload.page = window.location.pathname;
        payload.locale = (document.documentElement.lang || 'fr').slice(0, 2);
        if (!payload.name) payload.name = '(non précisé)';
        if (!payload.service) payload.service = 'Demande générale';

        try {
          const r = await fetch('/api/lead.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const json = await r.json().catch(function() { return { ok: false, error: 'Réponse invalide' }; });
          if (r.ok && json.ok) {
            btn.textContent = '✓ Demande envoyée';
            btn.className = btn.className.replace('btn-coral', 'btn-success') + ' bg-emerald-600 hover:bg-emerald-700 text-white';
            if (msg) { msg.textContent = 'Merci, on revient vers vous sous 24h.'; msg.className = msg.className.replace('text-slate-500', '') + ' text-emerald-600'; }
            form.querySelectorAll('input:not([type="hidden"]), textarea, select').forEach(function(el) {
              if (el.type !== 'submit') el.value = '';
            });
          } else {
            throw new Error(json.error || 'Erreur réseau');
          }
        } catch (err) {
          btn.disabled = false;
          btn.textContent = orig;
          if (msg) { msg.textContent = 'Erreur : ' + err.message + '. Réessayez ou écrivez-nous à contact@wpsolution.io.'; msg.className = msg.className.replace('text-slate-500', '') + ' text-red-600'; }
        }
      });
    }
    function init() {
      document.querySelectorAll('[data-lead-form]').forEach(attachLead);
    }
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>
