---
// Sticky bottom bar on mobile - always visible CTA to lead form
import { SITE } from "../data/site";
---
<div class="fixed bottom-4 left-4 right-4 z-40 md:hidden">
  <div class="bg-white shadow-2xl shadow-slate-900/30 rounded-2xl border border-slate-200 p-3 flex gap-2">
    <a href={SITE.phoneHref} class="flex items-center justify-center gap-2 flex-1 bg-slate-100 hover:bg-slate-200 text-slate-900 font-semibold py-3 rounded-xl text-sm transition-colors">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      Appeler
    </a>
    <a href="#lead-form" class="flex items-center justify-center gap-2 flex-1 btn-coral !py-3 !text-sm">
      Devis gratuit
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
  </div>
</div>
